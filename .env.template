# Nyno runtime ports
# Copy this file to .env and set a fresh SECRET before starting Nyno.

# workflow TCP server
WF=9024

# GUI / HTTP server
GU=9057

# runner ports: PY=python, JS=node, DN=deno, PE=php swoole, RB=ruby
PY=9006
JS=9072
DN=9073
PE=9003
RB=9045

# Required. Generate a fresh high-entropy value for each deployment.
# Example: openssl rand -hex 32
SECRET=""

# Default to localhost for reverse-proxy deployments.
# Use 127.0.0.1 when nginx runs on the same host and terminates HTTPS.
# Use 0.0.0.0 only when container/network/firewall rules prevent direct public access.
HOST="127.0.0.1"
